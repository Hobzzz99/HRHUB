# ---------------------------------------------------------------------------
# TalentFinder — PRODUCTION environment (server half)
#
#   cp .env.prod.example .env.prod    then fill in every REPLACE_ value.
#
# This file lives only on the server. It is secrets, so it must never be
# committed — .gitignore already covers .env*, but check before you push.
#
# The scraping worker does NOT use this file. Its settings are in
# infra/worker-pc/.env.worker.example, on the recruiter's PC.
# ---------------------------------------------------------------------------

# --- Public identity ---
# The domain users type. DNS A record must already point at this server.
SITE_DOMAIN=talent.yourcompany.com
PUBLIC_URL=https://talent.yourcompany.com

# --- App ---
# prod is load-bearing, not cosmetic: it is what makes the API ignore
# AUTH_DISABLED and enforce real JWT verification (see core/security.py).
APP_ENV=prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Same-origin because Caddy serves the API under /api on the site domain.
CORS_ORIGINS=https://talent.yourcompany.com

# --- Postgres ---
POSTGRES_USER=talentfinder
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=talentfinder

# --- Redis ---
# Required. Redis has no authentication by default, and the worker PC reaches
# it through a tunnel, so it must not be left open even on loopback.
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# --- Celery ---
# Set explicitly, never left to a default. When this is not defined in the
# container environment, pydantic falls back to any .env baked into the image —
# which is exactly how the API ended up running scrape jobs itself instead of
# queueing them for a recruiter's laptop.
CELERY_TASK_ALWAYS_EAGER=false

# --- Candidate data source ---
# The API never scrapes; it only reads what the worker stored. Leaving this as
# mock on the server is correct — the worker PC sets linkedin for itself.
PROVIDER=mock
PROFILE_TTL_DAYS=7

# --- Credential / session encryption (Fernet) ---
# Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe. Losing it invalidates every stored LinkedIn
# session, which means signing in by hand again.
# The worker PC must use THE SAME KEY or it cannot read the sessions it wrote.
CREDENTIAL_ENC_KEY=REPLACE_WITH_FERNET_KEY

# --- Auth (Supabase) ---
# Required in prod. Create a free project at supabase.com.
SUPABASE_URL=https://REPLACE.supabase.co

# Two signing styles exist, and current Supabase projects use the second one.
# Getting this wrong produces a 401 on every login with the API logging
# "The specified alg value is not allowed".
#
#   Asymmetric ES256/RS256  (DEFAULT on current projects)
#     Leave SUPABASE_JWT_SECRET **blank** and set SUPABASE_JWKS_URL below.
#     security.py prefers the secret whenever it is set, so a leftover value
#     silently keeps the wrong path active.
#
#   Legacy HS256
#     Set SUPABASE_JWT_SECRET (Project Settings > API > JWT Settings) and leave
#     SUPABASE_JWKS_URL blank.
#
# To check which you have:
#   curl -s https://REPLACE.supabase.co/auth/v1/.well-known/jwks.json
# Keys listed with "alg": "ES256" or "RS256" mean asymmetric — use JWKS.
#
# Careful: on a current project the *anon API key* is still an HS256 JWT signed
# by the legacy secret, while *user login tokens* are ES256. The secret can
# therefore look correct while rejecting every real login.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://REPLACE.supabase.co/auth/v1/.well-known/jwks.json
# Verified, not merely decoded. Note the /auth/v1 suffix.
SUPABASE_JWT_ISSUER=https://REPLACE.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Ignored when APP_ENV=prod, kept explicit so nobody assumes otherwise.
AUTH_DISABLED=false

# --- Frontend (baked into the browser bundle at build time) ---
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# --- AI semantic matching (optional, costs money per candidate) ---
AI_MATCHING=off
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
