# ---------------------------------------------------------------------------
# TalentFinder — scraping worker (recruiter's PC half)
#
#   copy .env.worker.example .env.worker    then fill in the REPLACE_ values.
#
# This is the only machine that touches LinkedIn. It needs a screen, because
# sign-in and CAPTCHAs are cleared by hand.
#
# Postgres and Redis are reached at 127.0.0.1 through the SSH tunnel opened by
# tunnel.ps1 — the server does not expose them to the network.
# ---------------------------------------------------------------------------

APP_ENV=prod
LOG_LEVEL=INFO

# --- Whose laptop this is ---
# The recruiter's user id, from Supabase (Authentication > Users). This laptop
# takes only that recruiter's searches, because it scrapes with their LinkedIn
# account. Get this wrong and it collects a colleague's search and runs it
# against the wrong account — see backend/app/workers/routing.py.
WORKER_USER_ID=REPLACE_WITH_THIS_RECRUITERS_USER_ID

# --- Server connections, via the tunnel (tunnel.ps1 must be running) ---
DATABASE_URL=postgresql+psycopg://talentfinder:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:15432/talentfinder
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:16379/0
CELERY_BROKER_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:16379/2
CELERY_TASK_ALWAYS_EAGER=false

# --- This is the machine that scrapes ---
PROVIDER=linkedin
PROFILE_TTL_DAYS=7
SCRAPE_MAX_PROFILES=30

# --- The control that protects the account ---
# Volume is what LinkedIn's abuse detection keys on. This ceiling is the reason
# the system is survivable at all; raising it is how accounts get restricted.
#
# It is enforced per worker process against a file in SCRAPE_STATE_DIR. Run ONE
# worker at concurrency 1 (start-worker.ps1 does). Two workers would each get
# their own budget and quietly double the real rate.
SCRAPE_MAX_PROFILES_PER_HOUR=30
SCRAPE_RATE_LIMIT_WINDOW_S=3600
SCRAPE_RATE_LIMIT_MAX_WAIT_S=600
# Persisted so the budget survives restarts instead of handing out a fresh one.
# Keep this on a real path that is backed up with the machine, not a temp dir.
SCRAPE_STATE_DIR=C:/TalentFinder/state

# --- Manual sign-in: a human clears the login and the CAPTCHA ---
SCRAPE_HEADLESS=false
SCRAPE_LOGIN_TIMEOUT_S=600
SCRAPE_CHALLENGE_TIMEOUT_S=300

# --- Behaviour emulation ---
SCRAPE_HUMANIZE=true
# Fingerprint patching. Currently false because the patched values disagreed
# with what the sign-in CAPTCHA fingerprints, which showed up as a login that
# looped back after the CAPTCHA was solved. Revisit only with a spare account.
SCRAPE_STEALTH=false
SCRAPE_MIN_DELAY_MS=1500
SCRAPE_MAX_DELAY_MS=4000
SCRAPE_NAVIGATION_TIMEOUT_S=60
SCRAPE_LOCALE=en-US
# Leave blank to report this machine's real timezone — which is the honest
# answer and the one that matches the IP.
SCRAPE_TIMEZONE=

# --- Must match the server exactly ---
# Sessions are encrypted with this key and stored centrally. A different key
# here means the worker cannot read back the session it saved.
CREDENTIAL_ENC_KEY=REPLACE_WITH_SAME_FERNET_KEY_AS_SERVER

# --- Auth is the API's job, not the worker's ---
AUTH_DISABLED=false
