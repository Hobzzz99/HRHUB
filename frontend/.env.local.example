# Copy to `.env.local` for local `npm run dev`.
# NEXT_PUBLIC_* values are inlined at build time.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Dev bypass: when true, the app sends no auth token and uses SSE for live
# updates (the backend must also have AUTH_DISABLED=true).
NEXT_PUBLIC_AUTH_DISABLED=true

# Supabase (only needed when NEXT_PUBLIC_AUTH_DISABLED=false)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
