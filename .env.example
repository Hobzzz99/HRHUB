# ---------------------------------------------------------------------------
# Candidate Search Platform — environment template
# Copy to `.env` and fill in. Values below are safe local-dev defaults.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=dev                     # dev | staging | prod
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000

# --- Postgres (used by docker-compose to provision the DB container) ---
POSTGRES_USER=candidates
POSTGRES_PASSWORD=candidates
POSTGRES_DB=candidates
# SQLAlchemy URL the backend/worker connect with.
# In docker-compose the host is `postgres`; for host-run use `localhost`.
DATABASE_URL=postgresql+psycopg://candidates:candidates@postgres:5432/candidates
# --- Production: Supabase-hosted Postgres ---
# Use your project's connection string (Supabase dashboard -> Project Settings ->
# Database). Prefer the pooler for serverless. Note the `+psycopg` driver suffix:
#   DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.rpwudywzpeercdaedvgb.supabase.co:5432/postgres
# Run `alembic upgrade head` once against it to create the schema.

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Run search jobs inline (no Redis) for local dev without a worker. Leave false
# in production so the Celery worker processes jobs asynchronously.
CELERY_TASK_ALWAYS_EAGER=false

# --- Candidate data source ---
# mock     = deterministic fixtures, no account needed (DEFAULT, safe).
# linkedin = we scrape LinkedIn ourselves with your own account. You sign in and
#            clear CAPTCHAs by hand; the app never types credentials. Opt-in,
#            breaches LinkedIn's ToS, and can get the account restricted — see
#            COMPLIANCE.md.
# apify    = LinkedIn data bought from Apify Actors. No LinkedIn account is
#            involved, so there is nothing to get banned. Needs APIFY_TOKEN.
PROVIDER=mock
PROFILE_TTL_DAYS=7              # reuse a cached candidate profile if fetched within N days
SCRAPE_MAX_PROFILES=20          # cap profiles opened per search (after pre-filter)

# --- Scrape rate limit (PROVIDER=linkedin) ---
# The control that actually protects the account: volume is what abuse detection
# keys on. Counted in a rolling window that is persisted to SCRAPE_STATE_DIR, so
# it survives worker restarts instead of resetting to a fresh budget.
SCRAPE_MAX_PROFILES_PER_HOUR=20
SCRAPE_RATE_LIMIT_WINDOW_S=3600
# How long a running search waits for the next slot before stopping early and
# keeping what it already collected.
SCRAPE_RATE_LIMIT_MAX_WAIT_S=600
SCRAPE_STATE_DIR=_state

# --- Manual sign-in (PROVIDER=linkedin) ---
# Login and CAPTCHAs are done by hand in a real window, so headless cannot work.
SCRAPE_HEADLESS=false
SCRAPE_LOGIN_TIMEOUT_S=600      # how long to wait for you to finish signing in
SCRAPE_CHALLENGE_TIMEOUT_S=300  # how long to wait for you to clear a CAPTCHA

# --- Human behaviour emulation (PROVIDER=linkedin) ---
# Bezier pointer paths with overshoot, inertial scroll bursts, log-normal pacing
# with micro-breaks, typo-correcting typing, fingerprint consistency, and a
# 10-point honeypot check before any click. Off is faster but obviously a bot.
SCRAPE_HUMANIZE=true
# Browser fingerprint + anti-automation patching, separate from the behaviour
# above. This is the layer most likely to CAUSE trouble: sign-in CAPTCHAs
# fingerprint the browser, and patched values that disagree can fail their check
# — which looks like a login that loops back after the CAPTCHA is solved. Set
# false to test whether that is what is happening.
SCRAPE_STEALTH=true
SCRAPE_BEHAVIOR_SEED=           # set to make a run's behaviour reproducible
SCRAPE_MIN_DELAY_MS=1500        # midpoint of these becomes the median action gap
SCRAPE_MAX_DELAY_MS=4000
SCRAPE_TIMEZONE=                # IANA tz reported to the page; blank = this host's
SCRAPE_LOCALE=en-US
# How long one page load may take. Playwright's own default is 30s, which
# LinkedIn exceeds often enough to abort otherwise-healthy runs.
SCRAPE_NAVIGATION_TIMEOUT_S=60

# --- Apify (PROVIDER=apify) ---
# Token: https://console.apify.com/account/integrations (free tier ~$5 credit).
APIFY_TOKEN=
# Actor ids, "username/actor-name". Both defaults are COOKIELESS. Do not swap in
# a cookie-based actor: handing an Actor a LinkedIn session cookie re-introduces
# the account-ban risk this provider exists to avoid.
APIFY_SEARCH_ACTOR=harvestapi/linkedin-profile-search
APIFY_PROFILE_ACTOR=dev_fusion/linkedin-profile-scraper
APIFY_TIMEOUT_S=300             # a sync actor run caps out at 300s server-side
APIFY_DEBUG_DUMP=false          # dump every raw actor response to _debug/

# --- Credential / session encryption (Fernet) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENC_KEY=REPLACE_WITH_FERNET_KEY

# --- AI semantic matching (optional) ---
AI_MATCHING=off                 # off | on
ANTHROPIC_API_KEY=
# Most capable default; set a cheaper model (e.g. claude-sonnet-5) to reduce cost.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Auth (Supabase) ---
# Frontend sign-in issues a JWT; the API verifies it.
SUPABASE_URL=
# Legacy HS256 projects: set the JWT secret (API verifies with it).
SUPABASE_JWT_SECRET=
# Modern asymmetric projects (ES256/RS256): set the JWKS URL instead.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Local-dev escape hatch: when true AND APP_ENV=dev, the API skips JWT
# verification and injects DEV_USER_ID so the whole app runs without Supabase.
AUTH_DISABLED=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=dev@example.com

# --- Frontend (Next.js — NEXT_PUBLIC_* are exposed to the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mirror of AUTH_DISABLED for the web app's dev bypass.
NEXT_PUBLIC_AUTH_DISABLED=true
